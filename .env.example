# Application Configuration
# Copy to .env.local and adjust values for your environment

# Server
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# Device: leave empty for auto-detect (MPS -> CUDA -> CPU), or set to force
# Options: cpu, cuda, mps
FORCE_DEVICE=

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*

# Model checkpoints directory (absolute or relative to project root)
MODEL_DIR=models

# Monitoring
# SQLite database path for inference event logging (relative to project root or absolute)
MONITORING_DB_PATH=monitoring/data/inference_events.sqlite3

# Evidently dashboard URL — redirect target for /model-performance route
# Leave empty to show a "not configured" message instead of redirecting
EVIDENTLY_DASHBOARD_URL=

# Evidently Cloud (optional — used by scripts/monitoring/run_evidently.py)
# Leave all four empty to run in offline mode (local HTML/JSON output only)
EVIDENTLY_API_URL=https://app.evidently.cloud
EVIDENTLY_API_KEY=
EVIDENTLY_PROJECT_ID=

# Local offline output directory for Evidently reports when cloud creds are absent
EVIDENTLY_OFFLINE_OUTPUT_DIR=monitoring/output
